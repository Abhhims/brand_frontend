# Copy to .env for local development. Empty values fall back to the defaults in src/config/env.ts.

# ---- runtime
NODE_ENV=development
PORT=8020
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
TRUST_PROXY=0
RATE_LIMIT_PER_MINUTE=600
API_DOCS_ENABLED=true

# ---- Postgres (docker compose in this folder exposes 5433 so it never clashes with the legacy stack)
DATABASE_URL=postgres://brandintel:brandintel@localhost:5433/brandintel
DATABASE_READ_URL=
DB_POOL_MAX=20
DB_STATEMENT_TIMEOUT_MS=30000

# ---- Redis (cache, rate limits, job queues) — exposed on 6380
REDIS_URL=redis://localhost:6380/0
REDIS_KEY_PREFIX=bi:
CACHE_DEFAULT_TTL_SECONDS=60

# ---- object storage (S3-compatible; RustFS locally on 9100, console http://localhost:9101)
S3_ENDPOINT_URL=http://localhost:9100
S3_PUBLIC_ENDPOINT_URL=
S3_ACCESS_KEY=brandintel
S3_SECRET_KEY=brandintel-secret
S3_BUCKET=evidence
S3_REGION=us-east-1
S3_URL_EXPIRE_SECONDS=3600

# ---- workers
QUEUE_PREFIX=bi
WORKER_CONCURRENCY=5
WORKER_QUEUES=default,browser,system

# ---- auth (CHANGE in production: the API refuses to start with these defaults)
JWT_SECRET=change-me-in-production
JWT_EXPIRE_MINUTES=720
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=ChangeMe!2026

# ---- Apify (Instagram scrapers; paid per result). Without a token, Apify sources report "not configured".
APIFY_TOKEN=
APIFY_PLATFORMS=instagram
APIFY_ITEMS_PER_QUERY=20
APIFY_SCAM_QUERIES=3
APIFY_MAX_CHARGE_USD=0.5
APIFY_RUN_TIMEOUT_SECONDS=300
APIFY_CACHE_MINUTES=180
# Actor ids (owner/name) — change only to switch to a different scraper
APIFY_ACTOR_INSTAGRAM=apify/instagram-scraper
APIFY_ACTOR_INSTAGRAM_POSTS=apify/instagram-hashtag-scraper

# ---- social media monitoring
SOCIAL_MEDIA_LOOKBACK_DAYS=730
SOCIAL_MEDIA_SCAM_LOOKBACK_DAYS=730
SOCIAL_MEDIA_SCAM_QUERIES={brand} customer care number,{brand} helpline number,{brand} kyc update,{brand} loan fraud,{brand} refund
# analysis after each collection (relevance, scam contacts/wording, logo in thumbnails, risk score)
SOCIAL_MEDIA_ANALYSIS_BUDGET_SECONDS=900
SOCIAL_MEDIA_ANALYSE_REQUEST_SECONDS=120
SOCIAL_MEDIA_ANALYSIS_CONCURRENCY=4

# ---------------------------------------------------------------- outbound HTTP (safe fetcher)
# Every request to an outside website (post thumbnails) goes through the safe fetcher:
# private/internal addresses are blocked, redirects re-checked, size and time capped.
FETCH_TIMEOUT_SECONDS=15
FETCH_MAX_BYTES=3145728
FETCH_MAX_REDIRECTS=5
FETCH_PER_HOST_PER_MINUTE=120
# Hosts allowed to resolve to private addresses — local test fixtures only, keep empty in production
FETCH_ALLOW_PRIVATE_HOSTS=
