# Base URL of the Node.js backend API, as reached from the analyst's browser (no trailing slash).
# The backend listens on PORT from backend/.env (8020 by default); its CORS_ORIGINS must include this app's origin.
NEXT_PUBLIC_API_URL=http://localhost:8020
# true = talk to the API: real sign-in (POST /api/v1/auth/login) and live data on every page.
# false = no request leaves the browser and pages show "backend not connected" (useful for UI-only work).
NEXT_PUBLIC_API_ENABLED=true
